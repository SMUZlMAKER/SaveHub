{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SaveHub",
  "version": "0.8.3",
  "identifier": "io.github.savehub",
  "build": {
    "frontendDist": "frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "SaveHub",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false
      },
      {
        "label": "launch",
        "create": false,
        "title": "Запуск игры — SaveHub",
        "url": "index.html?launch",
        "width": 480,
        "height": 540,
        "resizable": false,
        "center": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
